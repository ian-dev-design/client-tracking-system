/**
 * GENERATED by `npm run crm -- survey-script` from config.json — edit config.json, not this file.
 *
 * One-time setup, run under YOUR Google account (so you own everything):
 *   - creates the "CRM Database" Google Sheet
 *   - creates the discovery survey (Google Form) with email collection ON
 *   - links the form's responses into the Sheet as the "survey_responses_raw" tab
 *   - prints the IDs to paste into config.json
 *
 * How to run: go to https://script.google.com → New project → paste this file →
 * click Run (function: createCrm) → approve the permissions → open "Execution log".
 */
var FORM_TITLE = "Quick survey from GoatOps: how you handle grounds and land maintenance";
var QUESTIONS = [
  {
    "title": "What's your role?",
    "type": "text",
    "required": true
  },
  {
    "title": "What organization do you work for?",
    "type": "text"
  },
  {
    "title": "What kind of organization is it?",
    "type": "choice",
    "choices": [
      "Office park",
      "School or university",
      "City or parks department",
      "Warehouse",
      "Apartment complex",
      "HOA",
      "Church",
      "Golf course",
      "Other"
    ]
  },
  {
    "title": "How is grounds and land maintenance handled today? (Who does it, and how often?)",
    "type": "paragraph"
  },
  {
    "title": "What tools, vendors, or services do you use for it?",
    "type": "paragraph"
  },
  {
    "title": "What are the biggest headaches with grounds and land maintenance right now?",
    "type": "paragraph",
    "required": true
  },
  {
    "title": "Roughly how much do you spend on it per year?",
    "type": "choice",
    "choices": [
      "Under $5k",
      "$5k–$25k",
      "$25k–$100k",
      "Over $100k",
      "Not sure"
    ]
  },
  {
    "title": "What have you tried that didn't work?",
    "type": "paragraph"
  },
  {
    "title": "If you could change one thing about how grounds and land maintenance gets done, what would it be?",
    "type": "paragraph"
  },
  {
    "title": "Would you be open to a 20-minute chat to go deeper?",
    "type": "choice",
    "choices": [
      "Yes",
      "Maybe",
      "No"
    ],
    "required": true
  }
];

function createCrm() {
  var ss = SpreadsheetApp.create('CRM Database');

  var form = FormApp.create(FORM_TITLE);
  form.setDescription('Takes about 3 minutes. Your answers help us understand how organizations like yours work. Thank you!');
  form.setCollectEmail(true);           // Google's own "Email" field
  form.setProgressBar(true);
  form.setConfirmationMessage('Thank you! We really appreciate it.');

  // Prefillable email question: outreach links fill this in so responses match reliably.
  var emailItem = form.addTextItem()
    .setTitle('Your email (so we can match your answers)')
    .setRequired(true);

  QUESTIONS.forEach(function (q) {
    var item = q.type === 'choice' ? form.addMultipleChoiceItem().setChoiceValues(q.choices)
      : q.type === 'paragraph' ? form.addParagraphTextItem()
      : form.addTextItem();
    item.setTitle(q.title).setRequired(!!q.required);
  });

  // Send responses into the CRM Sheet, then rename that tab.
  form.setDestination(FormApp.DestinationType.SPREADSHEET, ss.getId());
  SpreadsheetApp.flush();
  Utilities.sleep(3000);
  var sheets = SpreadsheetApp.openById(ss.getId()).getSheets();
  for (var i = 0; i < sheets.length; i++) {
    if (sheets[i].getFormUrl()) { sheets[i].setName('survey_responses_raw'); break; }
  }

  // Find the entry ID of the email question from a prefilled URL.
  var prefilled = form.createResponse()
    .withItemResponse(emailItem.asTextItem().createResponse('test@example.com'))
    .toPrefilledUrl();
  var entryId = (prefilled.match(/(entry\.\d+)=/) || [])[1] || '';

  Logger.log('=== Paste these into config.json ===');
  Logger.log('"surveyLink": "' + form.getPublishedUrl() + '",');
  Logger.log('"formId": "' + form.getId() + '",');
  Logger.log('"emailEntryId": "' + entryId + '",');
  Logger.log('"spreadsheetId": "' + ss.getId() + '",');
  Logger.log('Sheet: ' + ss.getUrl());
  Logger.log('Edit form: ' + form.getEditUrl());
}
