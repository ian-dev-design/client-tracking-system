# Copy to .env.local and fill in. Never commit .env.local.

# "demo" = local fake data in .demo-data/ (no Google needed). "sheets" = the real Google Sheet.
DATA_BACKEND=demo

# Your name — used as the actor/sender when Claude Code commands write to the Sheet.
OWNER_NAME=YourName

# --- Sign-in (Google OAuth client, consent screen = Internal) ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
GOOGLE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-oauth-client-secret

# Comma-separated emails allowed into the app = the team. Only the owner edits this.
# Optionally give a name: "Ian <you@berkeley.edu>, Jamie Lee <jamie@berkeley.edu>".
# Without one, the name is the first part of the email (jamie.lee@… → Jamie).
ALLOWED_EMAILS=you@berkeley.edu,teammate@berkeley.edu

# --- Service account that reads/writes the Sheet and Drive ---
# Paste the whole JSON key on one line. Store ONLY here and in Netlify env vars.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"...","private_key":"..."}

# --- Safety: while testing, every "Approve & send" email is redirected here ---
# Remove this line only when you're ready to email real contacts.
EMAIL_TEST_REDIRECT=you@berkeley.edu

# --- Team notifications (internal emails to teammates only) ---
# Protects the daily job (/api/cron/daily). Netlify's scheduled function (netlify/functions/daily.mts) sends it.
# CRON_SECRET=long-random-string
# The account that sends scheduled emails (digest, newly urgent tasks) when nobody is signed in.
# Get the token from Settings → Notifications → "Use my account as the sender". Never commit it.
# NOTIFY_SENDER_EMAIL=you@berkeley.edu
# NOTIFY_SENDER_REFRESH_TOKEN=

# --- Optional: turns on AI drafting/extraction inside the app ---
# ANTHROPIC_API_KEY=sk-ant-...

# --- Optional: only used after deploying (Apps Script form-submit ping) ---
# SURVEY_SYNC_SECRET=long-random-string

# --- Demo mode only: who you're "signed in" as when Google sign-in isn't set up ---
DEMO_USER_NAME=Ian
DEMO_USER_EMAIL=you@berkeley.edu
